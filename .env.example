# Local demonstration only. Replace these values before any shared deployment.
QUILR_JWT_SECRET=local-demo-secret-replace-before-deployment-32bytes
QUILR_TENANT_KEYS={"local-demo-key":"demo-tenant"}
QUILR_DATABASE_PATH=data/usage.db
QUILR_DOWNSTREAM_URL=http://127.0.0.1:9001/mcp
QUILR_PRIMARY_URL=http://127.0.0.1:9001/primary/v1/chat/completions
QUILR_SECONDARY_URL=http://127.0.0.1:9001/secondary/v1/chat/completions
QUILR_PRIMARY_MODEL=demo-primary
QUILR_SECONDARY_MODEL=demo-secondary
QUILR_TOKEN_LIMIT=50000
QUILR_PRIMARY_TIMEOUT=3.0
